# Fairy Finds Boutique - Supabase Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Authentication
ADMIN_PASSWORD=fairyfinds@123

# Google Search Console Verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend Order Email Notifications (₹0/month Free Tier)
# Get your free API key at https://resend.com
RESEND_API_KEY=
# Store owner recipient email for new order alerts
ORDER_NOTIFICATION_EMAIL=
# Verified sender address or domain in Resend (default for testing: onboarding@resend.dev)
RESEND_FROM_EMAIL=Fairy Finds <orders@fairyfindsboutique.store>
# Set to false in local dev if you do not want emails triggered during development
EMAIL_NOTIFICATIONS_ENABLED=true
